node_modules/
dist/
src-tauri/target/
src-tauri/gen/
*.log
.DS_Store
Thumbs.db

# Playwright e2e 产物
test-results/
playwright-report/

# Agent 调试临时目录（探针脚本、日志、缓存等）。统一在项目内 .tmp/，
# 避开 cwd 根散落；Vite watch 也会忽略。git/rust/cargo/ESLint 默认都不
# 扫描它（未列入 include/exclude 即跳过）。
.tmp/
.tmp/**

# Laya 决策引擎的重资产：模型权重与 onnxruntime DLL（见 docs/08）。
# 权重本体不入库；每个 bundle 的 manifest.json（sha256+来源）必须入库，
# 供 scripts/verify-laya-models.ps1 校验/恢复。
models/laya-multilingual-onnx/**
!models/laya-multilingual-onnx/manifest.json
models/laya-onnx/**
!models/laya-onnx/manifest.json
vendor/
*.onnx
*.onnx.data

# Playwright MCP 运行产物（浏览器会话元数据、截图等）
.playwright-mcp/

# 马里奥实验室旧本地状态（已迁至 ~/.qianxun_dev/mario，见 docs/13）
var/

