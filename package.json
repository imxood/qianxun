{
  "name": "qianxun",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "千寻 —— 个人开发者的工作台：管理 DSH、承载工具、连接远程",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "prettier --check . && eslint . && svelte-check --tsconfig ./tsconfig.json && vitest run",
    "check:fix": "prettier --write . && eslint . --fix",
    "rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --workspace",
    "all:check": "pnpm check && pnpm rust:check",
    "tauri": "tauri"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@types/qrcode": "^1.5.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "marked": "^18.0.11",
    "qrcode": "^1.5.4",
    "svelte": "^5.42.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.4.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.8.0",
    "globals": "^17.12.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte-check": "^4.3.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^6.4.1",
    "vitest": "^4.1.5"
  }
}
